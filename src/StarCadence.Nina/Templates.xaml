<ResourceDictionary
    x:Class="StarCadence.Nina.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:NINA.Sequencer.Behaviors;assembly=NINA.Sequencer"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:StarCadence.Nina"
    xmlns:view="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--  The instruction's icon: a star inside a cadence ring.  -->
    <GeometryGroup x:Key="StarCadence.NightSVG">
        <PathGeometry Figures="M 50,8 C 52,30 56,34 78,36 C 56,38 52,42 50,64 C 48,42 44,38 22,36 C 44,34 48,30 50,8 Z" />
        <PathGeometry Figures="M 50,86 A 36,36 0 1 1 86,50 A 5,5 0 0 1 76,50 A 26,26 0 1 0 50,76 A 5,5 0 0 1 50,86 Z" />
        <EllipseGeometry Center="50,86" RadiusX="6" RadiusY="6" />
    </GeometryGroup>

    <HierarchicalDataTemplate DataType="{x:Type local:StarCadenceNightContainer}" ItemsSource="{Binding Items}">
        <view:HierarchicalSequenceContainerView>
            <view:HierarchicalSequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="5,5,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="StarCadence settings folder" />
                        <TextBox
                            MinWidth="320"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding DataFolder, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Content="Plate-solve centring"
                            IsChecked="{Binding PlateSolve}"
                            ToolTip="Centre each target with N.I.N.A.'s Center (plate solve) instead of a plain slew." />
                        <CheckBox
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Content="Park at the end"
                            IsChecked="{Binding ParkAtEnd}" />
                        <CheckBox
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Content="Park while waiting"
                            IsChecked="{Binding ParkWhileWaiting}"
                            ToolTip="During waits of 10 minutes or more, park the mount. Otherwise tracking and guiding are stopped while waiting." />
                        <CheckBox
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Content="Measure exposure, peak at"
                            IsChecked="{Binding MeasureExposure}"
                            ToolTip="Once a night per target and filter, take test frames after centring and set the exposure so the target star's peak lands at this share of the camera's range (like the ExoPlanets plug-in's Calculate Exposure Time)." />
                        <TextBox
                            Width="40"
                            VerticalAlignment="Center"
                            Text="{Binding TargetPeakPercent, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" Text="%" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontWeight="Bold"
                        Text="{Binding StatusText}" />
                    <TextBlock Text="{Binding CurrentText}" />
                    <TextBlock Text="{Binding NextText}" />
                    <TextBlock Text="{Binding CountsText}" />

                    <TextBlock Margin="0,10,0,2" Text="Before each target (after the slew or centring, before its exposures):" />
                    <Border MinHeight="40" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding BeforeEachTarget}">
                            <ItemsControl MinHeight="40" ItemsSource="{Binding Items}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontStyle="Italic"
                                Opacity="0.4"
                                Text="Drop instructions here to run on every target before its exposures (autofocus, for example)"
                                Visibility="{Binding Items.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}" />
                            <i:Interaction.Behaviors>
                                <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                            </i:Interaction.Behaviors>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,10,0,2" Text="After each target (after its exposures):" />
                    <Border MinHeight="40" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding AfterEachTarget}">
                            <ItemsControl MinHeight="40" ItemsSource="{Binding Items}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontStyle="Italic"
                                Opacity="0.4"
                                Text="Drop instructions here to run on every target after its exposures"
                                Visibility="{Binding Items.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}" />
                            <i:Interaction.Behaviors>
                                <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                            </i:Interaction.Behaviors>
                        </Grid>
                    </Border>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontStyle="Italic"
                        TextWrapping="Wrap"
                        Text="Plans from the StarCadence settings and target lists, observes target after target with N.I.N.A.'s own slew, filter and exposure steps, and re-plans after each one until dawn. Triggers on this instruction or above it (Meridian Flip, Autofocus, Dither, Center After Drift) work as usual. Leave the container itself empty; use the two areas above for extra steps." />
                </StackPanel>
            </view:HierarchicalSequenceContainerView.SequenceContainerContent>
        </view:HierarchicalSequenceContainerView>
    </HierarchicalDataTemplate>
</ResourceDictionary>
