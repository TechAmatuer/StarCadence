<ResourceDictionary
    x:Class="StarCadence.Nina.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:StarCadence.Nina"
    xmlns:view="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--  The instruction's icon: a star inside a cadence ring.  -->
    <GeometryGroup x:Key="StarCadence.NightSVG">
        <PathGeometry Figures="M 50,8 C 52,30 56,34 78,36 C 56,38 52,42 50,64 C 48,42 44,38 22,36 C 44,34 48,30 50,8 Z" />
        <PathGeometry Figures="M 50,86 A 36,36 0 1 1 86,50 A 5,5 0 0 1 76,50 A 26,26 0 1 0 50,76 A 5,5 0 0 1 50,86 Z" />
        <EllipseGeometry Center="50,86" RadiusX="6" RadiusY="6" />
    </GeometryGroup>

    <HierarchicalDataTemplate DataType="{x:Type local:StarCadenceNightContainer}" ItemsSource="{Binding Items}">
        <view:HierarchicalSequenceContainerView>
            <view:HierarchicalSequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="5,5,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="StarCadence settings folder" />
                        <TextBox
                            MinWidth="320"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding DataFolder, UpdateSourceTrigger=LostFocus}" />
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="Plate-solve centring"
                            IsChecked="{Binding PlateSolve}" />
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="Park at the end"
                            IsChecked="{Binding ParkAtEnd}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontWeight="Bold"
                        Text="{Binding StatusText}" />
                    <TextBlock Text="{Binding CurrentText}" />
                    <TextBlock Text="{Binding NextText}" />
                    <TextBlock Text="{Binding CountsText}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontStyle="Italic"
                        Text="Plans from the StarCadence settings and target lists, observes target after target with N.I.N.A.'s own slew, filter and exposure steps, and re-plans after each one until dawn. Leave this container empty." />
                </StackPanel>
            </view:HierarchicalSequenceContainerView.SequenceContainerContent>
        </view:HierarchicalSequenceContainerView>
    </HierarchicalDataTemplate>
</ResourceDictionary>
