<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows only: checks the N.I.N.A. plug-in assembly the way N.I.N.A.'s plug-in loader sees it (MEF exports), without N.I.N.A. itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>StarCadence.Nina.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StarCadence.Nina\StarCadence.Nina.csproj" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\examples\config.json;..\..\examples\sample-targets.csv;..\..\examples\sample-exoclock.json" Link="examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
